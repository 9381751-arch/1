# ============================================================
# Общие переменные. Скопируйте в .env и заполните значения.
# В каждом подпроекте (bot/, dashboard/) есть свой .env.example
# с подмножеством этих переменных.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TG_CHANNEL_REQUESTS_ID=         # канал заявок клиентов
TG_GROUP_SELLERS_ID=            # группа продавцов
TG_MANAGER_ID=                  # личка менеджера для итоговых отчётов

# --- OSRM ---
# Публичный демо-сервер: https://router.project-osrm.org
# Для прода желательно поднять свой.
OSRM_BASE_URL=https://router.project-osrm.org

# --- Dashboard ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DASHBOARD_PUBLIC_URL=https://admin.azimut-stroy.pro
